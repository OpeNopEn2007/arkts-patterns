{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/hooks/iterate_user_prompt.py",
            "timeout": 10,
            "statusMessage": "检查 iterate 工程迭代上下文"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/hooks/iterate_stop.py",
            "timeout": 10,
            "statusMessage": "检查 iterate 收尾提醒"
          }
        ]
      }
    ]
  }
}
